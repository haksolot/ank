{"name":"--worktree","short":null,"takes_value":true,"repeatable":false}],"notes":["a target elsewhere is ank init <path>; with no argument it initialises the current directory","--at <path> puts the corpus outside this tree and declares it, so the tree gains no file","this verb pushes no ref, so no remote can change its exit code"],"refuses":[{"code":1,"when":"--repo: it names a repository that exists, and this verb makes one; the target is positional"}],"returns":[{"when":null,"fields":[{"name":"contract","type":"number","nullable":false},{"name":"created","type":"string[]","nullable":false},{"name":"wrote","type":"string[]","nullable":false},{"name":"added","type":"string[]","nullable":false},{"name":"changed","type":"boolean","nullable":false}]}]},{"name":"help","usage":"ank help [<verb>]","summary":"every verb grouped by the moment it is used, or one verb in full","group":"set up a repository","flags":[{"name":"--json","short":"-j","takes_value":false,"repeatable":false},{"name":"--quiet","short":"-q","takes_value":false,"repeatable":false},{"name":"--repo","short":"-r","takes_value":true,"repeatable":false},{"name":"--worktree","short":null,"takes_value":true,"repeatable":false}],"notes":[],"refuses":[{"code":2,"when":"no such verb; never a fallback to the general listing"}],"returns":[{"when":null,"fields":[{"name":"contract","type":"number","nullable":false},{"name":"verbs","type":"object[]","nullable":false},{"name":"verbs.name","type":"string","nullable":false},{"name":"verbs.usage","type":"string","nullable":false},{"name":"verbs.summary","type":"string","nullable":false},{"name":"verbs.group","type":"string","nullable":false},{"name":"verbs.flags","type":"object[]","nullable":false},{"name":"verbs.flags.name","type":"string","nullable":false},{"name":"verbs.flags.short","type":"string","nullable":true},{"name":"verbs.flags.takes_value","type":"boolean","nullable":false},{"name":"verbs.flags.repeatable","type":"boolean","nullable":false},{"name":"verbs.no