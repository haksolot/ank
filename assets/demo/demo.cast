[9.017126, "o", "\u001b[38;5;183mdepot\u001b[0m \u001b[38;5;245m$\u001b[0m a"]
[9.048101, "o", "n"]
[9.078632, "o", "k"]
[9.109552, "o", " "]
[9.140161, "o", "c"]
